              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"TC-20 Login role user -> 200\", function () { pm.expect([200]).to.include(pm.response.code); });",
              "pm.test(\"TC-20: role = user\", function () { pm.expect(pm.response.json().data.role).to.eql(\"user\"); });",
              "pm.collectionVariables.set(\"token_user\", pm.response.json().data.token);"
            ]
          }
        }
      ]
