                  "pm.test(\"Status code 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Response berformat JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Registrasi berhasil\", function () { pm.expect(pm.response.json().success).to.eql(true); });"
