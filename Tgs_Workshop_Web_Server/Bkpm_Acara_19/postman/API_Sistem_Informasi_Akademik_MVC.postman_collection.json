            "description": "Membuat user baru. Gunakan username dan email yang belum pernah terdaftar.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"adam_test\",\n    \"email\": \"adam_test@example.com\",\n    \"password\": \"Rahasia123!\"\n}",
