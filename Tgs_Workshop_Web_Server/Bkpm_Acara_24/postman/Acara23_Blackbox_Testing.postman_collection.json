    {
      "name": "TC-04 - Login dengan kredensial benar (AuthController::login)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Login dengan kredensial benar (AuthController::login)\nPartisi: Valid\nData uji: username & password benar\nHasil diharapkan: 200",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{auth_username}}\",\n  \"password\": \"{{auth_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"TC-04: Login dengan kredensial benar (AuthController::login) -> 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"TC-04: format JSON & success=true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
              "pm.environment.set(\"token\", pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
